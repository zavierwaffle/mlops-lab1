apiVersion: v1
kind: ConfigMap
metadata:
  name: s00-iris-config
  namespace: mlops-students
  labels:
    app.kubernetes.io/instance: s00-iris
data:
  MODEL_VERSION: iris-v1
  MODEL_PATH: /app/models/missing.joblib
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: s00-iris
  namespace: mlops-students
  labels:
    app.kubernetes.io/name: iris-api
    app.kubernetes.io/instance: s00-iris
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: iris-api
      app.kubernetes.io/instance: s00-iris-wrong-selector
  template:
    metadata:
      labels:
        app.kubernetes.io/name: iris-api
        app.kubernetes.io/instance: s00-iris
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: api
          image: REPLACE_WITH_IMAGE
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef:
                name: s00-iris-runtime
          ports:
            - name: http
              containerPort: 8000
          readinessProbe:
            httpGet:
              path: /ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /live
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
---
apiVersion: v1
kind: Service
metadata:
  name: s00-iris
  namespace: mlops-students
  labels:
    app.kubernetes.io/instance: s00-iris
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: iris-api
    app.kubernetes.io/instance: s00-iris-service
  ports:
    - name: http
      port: 80
      targetPort: api

